  "over": 0.02,
  "text": "We'll also need maintenance dredging, charging, the vessels themselves, operating subsidies—"
 },
 {
  "scene": "price",
  "at": 31,
  "who": "official",
  "voice": "Eddy (English (US))",
  "rate": 185,
  "dur": 2.574422,
  "slot": 6.85,
  "over": 0,
  "text": "Let's not get bogged down in details."
