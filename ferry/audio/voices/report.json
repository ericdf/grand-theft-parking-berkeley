 },
 {
  "scene": "wise",
  "at": 19.6,
  "who": "official",
  "voice": "Eddy (English (US))",
  "rate": 185,
  "dur": 5.182358,
  "slot": 8.649999999999997,
  "over": 0,
  "text": "We value your input. Your input has been received. Please stop inputting."
 },
 {
  "scene": "wise",
  "at": 28.4,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 3.359048,
  "slot": 4.450000000000001,
  "over": 0,
  "text": "For the big decisions, the project took a different route."
 },
 {
  "scene": "wise",
  "at": 33,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 2.45288,
  "slot": 4.0500000000000025,
  "over": 0,
  "text": "In Berkeley, every voice can be heard…"
 },
 {
  "scene": "wise",
  "at": 37.2,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 2.544989,
  "slot": 4.649999999999997,
