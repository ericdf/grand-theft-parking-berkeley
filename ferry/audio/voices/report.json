  "rate": 195,
  "dur": 2.553197,
  "slot": 4.050000000000001,
  "over": 0,
  "text": "I can explain that for two hundred thousand dollars."
 },
 {
  "scene": "wise",
  "at": 19.6,
  "who": "official",
  "voice": "Tom (Enhanced)",
  "rate": 185,
  "dur": 4.386122,
  "slot": 8.649999999999997,
  "over": 0,
  "text": "We value your input. Your input has been received. Please stop inputting."
 },
 {
  "scene": "wise",
  "at": 28.4,
  "who": "narrator",
  "voice": "Ava (Premium)",
  "rate": 175,
  "dur": 3.026168,
  "slot": 4.450000000000001,
  "over": 0,
  "text": "For the big decisions, the project took a different route."
 },
 {
  "scene": "wise",
  "at": 33,
  "who": "narrator",
  "voice": "Ava (Premium)",
  "rate": 175,
  "dur": 2.431338,
  "slot": 4.0500000000000025,
  "over": 0,
  "text": "In Berkeley, every voice can be heard…"
 },
 {
  "scene": "wise",
  "at": 37.2,
  "who": "narrator",
  "voice": "Ava (Premium)",
  "rate": 175,
  "dur": 2.77102,
  "slot": 4.649999999999997,
  "over": 0,
  "text": "…provided it doesn't interfere with the vision."
