  "who": "dry",
  "voice": "Fred",
  "rate": 165,
  "dur": 1.510748,
  "slot": 1.9499999999999997,
  "over": 0,
  "text": "Unless they don't."
 },
 {
  "scene": "promise",
  "at": 10.1,
  "who": "dry",
  "voice": "Fred",
  "rate": 165,
  "dur": 2.462766,
  "slot": 2.550000000000001,
  "over": 0,
  "text": "And you've ruined the Marina forever."
 },
 {
  "scene": "promise",
  "at": 12.8,
  "who": "dry",
  "voice": "Fred",
  "rate": 165,
  "dur": 1.330068,
  "slot": 8.449999999999998,
  "over": 0,
  "text": "For nothing."
 },
 {
  "scene": "promise",
  "at": 21.4,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 4.765261,
  "slot": 5.450000000000001,
  "over": 0,
  "text": "How did we get here? Well, once upon a time, in a city by the Bay…"
 },
 {
  "scene": "ferry",
  "at": 1,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 4.843583,
  "slot": 5.05,
  "over": 0,
  "text": "Once upon a time, before there was a Bay Bridge, Berkeley had an automobile ferry."
 },
 {
  "scene": "ferry",
  "at": 6.2,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 4.133152,
  "slot": 10.049999999999999,
  "over": 0,
  "text": "People drove to the waterfront, boarded a boat, and crossed the Bay."
 },
 {
  "scene": "ferry",
  "at": 16.4,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 4.123855,
  "slot": 5.250000000000002,
  "over": 0,
  "text": "But that was nearly a century ago. We've learned a great deal since then."
 },
 {
  "scene": "ferry",
  "at": 21.8,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 8.002041,
  "slot": 8.049999999999999,
  "over": 0,
  "text": "Today, Berkeley is committed to fighting climate change, reducing automobile dependence, and protecting our environment."
 },
 {
  "scene": "ferry",
  "at": 30,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 1.013016,
  "slot": 7.0500000000000025,
  "over": 0,
  "text": "Sometimes."
 },
 {
  "scene": "ferry",
  "at": 37.2,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 6.45746,
  "slot": 6.649999999999997,
  "over": 0,
  "text": "But we're getting ahead of our story. First, there was a beautiful waterfront. And a treasury with a problem."
 },
 {
  "scene": "treasury",
  "at": 0.5,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 3.933152,
  "slot": 4.35,
  "over": 0,
  "text": "The Marina had a piggy bank all its own: the Marina Enterprise Fund."
 },
 {
  "scene": "treasury",
  "at": 5,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 3.206712,
  "slot": 3.85,
  "over": 0,
  "text": "Boat slips, leases and operations kept it fed."
 },
 {
  "scene": "treasury",
  "at": 9,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 1.373243,
  "slot": 6.85,
  "over": 0,
  "text": "And it was very useful."
 },
 {
  "scene": "treasury",
  "at": 16,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 4.298413,
  "slot": 4.85,
  "over": 0,
  "text": "Meanwhile, the docks, the seawalls and the pilings kept getting older."
 },
 {
  "scene": "treasury",
  "at": 21,
  "who": "state",
  "voice": "Reed (English (US))",
  "rate": 175,
  "dur": 3.646667,
  "slot": 4.450000000000001,
  "over": 0,
  "text": "This is not how enterprise funds are typically used."
 },
 {
  "scene": "treasury",
  "at": 25.6,
  "who": "official",
  "voice": "Eddy (English (US))",
  "rate": 185,
  "dur": 2.797234,
  "slot": 6.85,
  "over": 0,
  "text": "Don't worry. We have another fund."
 },
 {
  "scene": "treasury",
  "at": 32.6,
  "who": "official",
  "voice": "Eddy (English (US))",
  "rate": 185,
  "dur": 1.998549,
  "slot": 4.450000000000001,
  "over": 0,
  "text": "It's a very healthy fund."
 },
 {
  "scene": "treasury",
  "at": 37.2,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 3.808254,
  "slot": 4.049999999999995,
  "over": 0,
  "text": "So the Marina borrowed from the City's Workers' Compensation Fund."
 },
 {
  "scene": "treasury",
  "at": 41.4,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 2.424036,
  "slot": 4.450000000000001,
  "over": 0,
  "text": "The Marina pig felt better. Briefly."
 },
 {
  "scene": "treasury",
  "at": 46,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 227,
  "dur": 6.583628,
  "slot": 6.450000000000001,
  "over": 0.13,
  "text": "The old Berkeley Pier closed in 2015. The docks needed work. The seawalls needed work. Nearly everything needed work."
 },
 {
  "scene": "treasury",
  "at": 52.6,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 2.650295,
  "slot": 3.2499999999999987,
  "over": 0,
  "text": "And then, one day, a miracle arrived."
 },
 {
  "scene": "miracle",
  "at": 8.4,
  "who": "magic",
  "voice": "Samantha",
  "rate": 150,
  "dur": 1.899864,
  "slot": 3.4499999999999997,
  "over": 0,
  "text": "If you build it, they will come."
 },
 {
  "scene": "miracle",
  "at": 12,
  "who": "official",
  "voice": "Eddy (English (US))",
  "rate": 185,
  "dur": 0.718458,
  "slot": 1.6500000000000008,
  "over": 0,
  "text": "Who?"
 },
 {
  "scene": "miracle",
  "at": 13.8,
  "who": "magic",
  "voice": "Samantha",
  "rate": 150,
  "dur": 0.744218,
  "slot": 8.049999999999999,
  "over": 0,
  "text": "The grants."
 },
 {
  "scene": "miracle",
  "at": 22,
  "who": "official",
  "voice": "Eddy (English (US))",
  "rate": 185,
  "dur": 2.541224,
  "slot": 3.4500000000000015,
  "over": 0,
  "text": "But where will the passengers come from?"
 },
 {
  "scene": "miracle",
  "at": 25.6,
  "who": "magic",
  "voice": "Samantha",
  "rate": 150,
  "dur": 1.862993,
  "slot": 7.85,
  "over": 0,
  "text": "Have you considered… parking?"
 },
 {
  "scene": "miracle",
  "at": 33.6,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 7.078231,
  "slot": 7.249999999999998,
  "over": 0,
  "text": "Proving, once again, that the best way to get people out of their cars is to give motorists an exciting new place to drive."
 },
 {
  "scene": "price",
  "at": 0.5,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 3.370113,
  "slot": 5.75,
  "over": 0,
  "text": "Of course, every fairy tale has a few obstacles."
 },
 {
  "scene": "price",
  "at": 6.4,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 1.671746,
  "slot": 18.85,
  "over": 0,
  "text": "The Bay here is rather shallow."
 },
 {
  "scene": "price",
  "at": 25.4,
  "who": "engineer",
  "voice": "Grandpa (English (US))",
  "rate": 212,
  "dur": 5.470249,
