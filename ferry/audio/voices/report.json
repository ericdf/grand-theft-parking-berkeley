 {
  "scene": "price",
  "at": 31,
  "who": "official",
  "voice": "Tom (Enhanced)",
  "rate": 185,
  "dur": 2.007483,
  "slot": 6.85,
  "over": 0,
  "text": "Let's not get bogged down in details."
 },
 {
  "scene": "wise",
  "at": 0.5,
  "who": "narrator",
  "voice": "Ava (Premium)",
  "rate": 175,
  "dur": 3.08458,
  "slot": 3.7500000000000004,
  "over": 0,
  "text": "Now, the kingdom had wise people of the waterfront."
 },
 {
  "scene": "wise",
  "at": 4.4,
  "who": "comm1",
  "voice": "Allison (Enhanced)",
  "rate": 180,
  "dur": 4.52449,
  "slot": 4.85,
  "over": 0,
  "text": "We've drawn up plans, a cost analysis, and an alternative site."
 },
 {
  "scene": "wise",
  "at": 9.4,
  "who": "comm2",
  "voice": "Karen (Premium)",
  "rate": 180,
  "dur": 1.344218,
  "slot": 2.4499999999999997,
  "over": 0,
  "text": "And we'll do it for free."
 },
 {
  "scene": "wise",
  "at": 12,
  "who": "official",
  "voice": "Tom (Enhanced)",
  "rate": 185,
  "dur": 2.294376,
  "slot": 3.2500000000000004,
  "over": 0,
  "text": "Free? But how will we know it's valuable?"
 },
 {
  "scene": "wise",
  "at": 15.4,
  "who": "consultant",
