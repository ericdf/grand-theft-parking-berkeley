  "rate": 180,
  "dur": 4.814286,
  "slot": 4.85,
  "over": 0,
  "text": "We've drawn up plans, a cost analysis, and an alternative site."
 },
 {
  "scene": "wise",
  "at": 9.4,
  "who": "comm2",
  "voice": "Sandy (English (US))",
