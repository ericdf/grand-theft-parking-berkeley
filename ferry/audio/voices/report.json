 {
  "scene": "wise",
  "at": 0.5,
  "who": "narrator",
  "voice": "Daniel",
  "rate": 175,
  "dur": 3.129615,
  "slot": 3.7500000000000004,
  "over": 0,
  "text": "Now, the kingdom had wise people of the waterfront."
 },
 {
